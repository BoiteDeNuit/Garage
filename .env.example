DB_NAME=garage
DB_USER=garage
DB_PASSWORD=
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
CURRENCY_API_URL=https://www.cbr-xml-daily.ru/daily_json.js
# Локально приложение работает по http, а Secure-куку браузер и newman по http не отправят
REFRESH_COOKIE_SECURE=false
# Пароль админа Grafana (http://localhost:3000). Локально смотреть дашборд можно без входа, на сервере пароль обязателен
GRAFANA_ADMIN_PASSWORD=
# Только для сервера (deploy/docker-compose.prod.yml): тег образа и внешний S3. Локально не нужны
APP_TAG=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
